{
  "name": "obsidian-proton-drive-sync",
  "version": "0.1.0",
  "description": "Sync your Obsidian vault via WebDAV with Proton Drive compatibility",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "webdav",
    "sync",
    "proton-drive"
  ],
  "author": "John Ferguson (john.ferguson@v1truv1us.dev)",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.14.0",
    "esbuild": "^0.21.0",
    "obsidian": "latest",
    "tslib": "^2.6.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0",
    "@vitest/coverage-v8": "^1.6.0"
  }
}
